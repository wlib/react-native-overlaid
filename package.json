{
  "name": "react-native-overlaid",
  "version": "0.2.0",
  "description": "Predictable overlays for React Native, React Native Web, and React.",
  "keywords": [
    "react",
    "react-native",
    "react-native-web",
    "overlay",
    "dialog",
    "sheet",
    "popover",
    "tooltip"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./lib/module/index.js",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./lib/module/index.js",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./styles.css": {
      "types": "./styles.css.d.ts",
      "default": "./styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.*",
    "docs",
    "!docs/PLAN.md",
    "!docs/PRODUCT.md",
    "!docs/PARITY.md",
    "!docs/TESTING.md",
    "!docs/screenshots",
    "!docs/videos",
    "examples",
    "styles.css",
    "styles.css.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bob build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --max-warnings 0",
    "pack:check": "npm run build && node scripts/check-package.mjs",
    "prepack": "npm run build",
    "screenshots:index": "node scripts/screenshots-index.mjs",
    "screenshots:ios": "node scripts/screenshots-ios.mjs",
    "screenshots:web": "node scripts/screenshots-web.mjs",
    "videos:index": "node scripts/videos-index.mjs",
    "videos:ios": "node scripts/videos-ios.mjs",
    "videos:web": "node scripts/videos-web.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test-storybook": "test-storybook",
    "test": "jest",
    "test:core": "jest --selectProjects core --runInBand",
    "test:native": "jest --selectProjects native --runInBand",
    "test:web": "jest --selectProjects web --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@floating-ui/react-dom": ">=2.1.0",
    "@lodev09/react-native-true-sheet": ">=3.11.0 <4",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "react-native": ">=0.76.0"
  },
  "peerDependenciesMeta": {
    "@floating-ui/react-dom": {
      "optional": true
    },
    "@lodev09/react-native-true-sheet": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/core": "^1.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.0",
    "@babel/preset-typescript": "^7.27.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.32.0",
    "@floating-ui/react-dom": "^2.1.0",
    "@lodev09/react-native-true-sheet": "^3.11.0",
    "@react-native/babel-preset": "^0.81.0",
    "@storybook/react-native-web-vite": "^9.1.20",
    "@storybook/test-runner": "^0.23.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.6.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-native": "^0.81.0",
    "react-native-builder-bob": "^0.40.0",
    "react-native-web": "^0.21.0",
    "react-test-renderer": "19.1.4",
    "storybook": "^9.1.20",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.4.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": false
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
